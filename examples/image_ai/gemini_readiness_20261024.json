  "facts": [
    {
      "id": "vertex-reference",
      "status": "confirmed",
      "scope": "vertex",
      "source_ids": [
        "vertex-pricing"
      ],
      "statement": "Vertex Globalの参考単価は入力0.25、テキスト/思考出力1.50、画像出力30 USD/100万token。1K画像は1120token。Developer APIの料金・最大量ではない。",
      "quote": "Gemini 3.1 Flash-Lite Image (Nano Banana 2 Lite) ... Global $0.25 ... Global $1.50 ... Global $30.00"
    },
    {
      "id": "budget-not-cap",
      "status": "confirmed",
      "scope": "cloud-billing",
      "source_ids": [
        "cloud-budget"
      ],
      "statement": "alerts-only予算は支出を自動停止しない。利用量報告の遅延を考慮する。spend cap budgetもサービス対応条件の確認が必要で、Developer APIの絶対上限として扱わない。",
      "quote": "For alerts-only budgets, the budget doesn't automatically set a hard cap on spending. ... account for delays in usage reporting."
    },
    {
      "id": "sdk-not-contract",
      "status": "confirmed",
      "scope": "sdk",
      "source_ids": [
        "google-sdk"
      ],
      "statement": "SDKはcandidate_count/max_output_tokens、ImageConfig 1K/1:1を定義。thinking_budget=0はDISABLEDだが、許容範囲はモデル依存。型定義だけで対象モデルの実対応・課金上限を証明しない。",
      "quote": "0 is DISABLED. -1 is AUTOMATIC. The default values and allowed ranges are model dependent."
    }
  ],
